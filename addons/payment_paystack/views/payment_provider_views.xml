<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_paystack" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.paystack</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider" position="inside">
                <group name="paystack_credentials" attrs="{'invisible': [('code', '!=', 'paystack')]}">
                    <field name="paystack_secret_key" password="True" attrs="{'required': [('code', '=', 'paystack'), ('state', '!=', 'disabled')]}"/>
                    <field name="paystack_public_key" attrs="{'required': [('code', '=', 'paystack'), ('state', '!=', 'disabled')]}"/>
                </group>
            </group>
        </field>
    </record>
</odoo> 