<odoo>
    <data>
        <!-- Define security groups -->
        <record id="group_subscription_admin" model="res.groups">
            <field name="name">eLearning Subscription Administrator</field>
            <field name="category_id" ref="base.module_category_elearning"/>
            <field name="implied_ids" eval="[(4, ref('website_slides.group_website_slides_manager'))]"/>
        </record>
        
        <!-- Record rules -->
        <record id="subscription_personal_rule" model="ir.rule">
            <field name="name">Personal Subscriptions</field>
            <field name="model_id" ref="model_elearning_subscription"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>