<odoo>
    <data noupdate="1">
        <!-- Free Preview Plan -->
        <record id="subscription_plan_free" model="elearning.subscription.plan">
            <field name="name">Free Preview</field>
            <field name="price">0.00</field>
            <field name="duration_months">1</field>
            <field name="free_preview_limit">5</field>
            <field name="allow_voucher">False</field>
            <field name="allow_certification">False</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- Standard Plan -->
        <record id="subscription_plan_standard" model="elearning.subscription.plan">
            <field name="name">Standard</field>
            <field name="price">9.99</field>
            <field name="duration_months">1</field>
            <field name="free_preview_limit">0</field>
            <field name="max_courses">5</field>
            <field name="max_downloads">10</field>
            <field name="allow_voucher">False</field>
            <field name="allow_certification">True</field>
            <field name="allow_forum">True</field>
            <field name="sequence">20</field>
        </record>
        
        <!-- Scholar Plan -->
        <record id="subscription_plan_scholar" model="elearning.subscription.plan">
            <field name="name">Scholar</field>
            <field name="price">19.99</field>
            <field name="duration_months">1</field>
            <field name="free_preview_limit">0</field>
            <field name="max_courses">0</field>
            <field name="max_downloads">50</field>
            <field name="allow_voucher">True</field>
            <field name="allow_certification">True</field>
            <field name="allow_forum">True</field>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>