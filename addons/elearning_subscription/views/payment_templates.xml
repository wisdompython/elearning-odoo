<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Payment Confirmation Template -->
        <template id="payment_confirmation" name="Subscription Payment Confirmation">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="alert alert-success">
                        <h4>Payment Successful!</h4>
                        <p>Your subscription has been activated successfully.</p>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Subscription Details</h5>
                                </div>
                                <div class="card-body">
                                    <p><strong>Plan:</strong> <t t-esc="subscription.plan_id.name"/></p>
                                    <p><strong>Reference:</strong> <t t-esc="subscription.name"/></p>
                                    <p><strong>Start Date:</strong> <span t-field="subscription.start_date"/></p>
                                    <p><strong>End Date:</strong> <span t-field="subscription.end_date"/></p>
                                    <p><strong>Amount:</strong> <span t-field="subscription.price" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a href="/my/subscriptions" class="btn btn-primary">View My Subscriptions</a>
                        <a href="/slides" class="btn btn-secondary ml-2">Browse Courses</a>
                    </div>
                </div>
            </t>
        </template>
        
        <!-- Payment Failed Template -->
        <template id="payment_failed" name="Subscription Payment Failed">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="alert alert-danger">
                        <h4>Payment Failed</h4>
                        <p>There was an issue processing your payment. Please try again or contact support.</p>
                    </div>
                    <div class="mt-4">
                        <a href="/my/subscriptions" class="btn btn-primary">Return to Subscriptions</a>
                    </div>
                </div>
            </t>
        </template>
        
        <!-- Payment Processing Template -->
        <template id="payment_processing" name="Processing Subscription Payment">
            <t t-call="portal.portal_layout">
                <div class="container mt-4 text-center">
                    <h3>Processing Your Payment</h3>
                    <div class="mt-4 mb-4">
                        <i class="fa fa-spinner fa-spin fa-3x"></i>
                    </div>
                    <p>Please wait while we process your payment...</p>
                    <p class="small text-muted">You will be redirected automatically once the payment is complete.</p>
                </div>
            </t>
        </template>
        
        <!-- Subscription Payment Form -->
        <template id="subscription_payment_form" name="Subscription Payment">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h2>Complete Your Subscription</h2>
                    
                    <div class="row mt-4">
                        <div class="col-lg-8">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Payment Details</h5>
                                </div>
                                <div class="card-body">
                                    <!-- Payment form will be injected here by the payment module -->
                                    <div t-if="payment_form_html" t-raw="payment_form_html"/>
                                    
                                    <!-- Fallback if payment form not available -->
                                    <div t-else="" class="alert alert-warning">
                                        Payment methods are not configured. Please contact the administrator.
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Order Summary</h5>
                                </div>
                                <div class="card-body">
                                    <p><strong>Plan:</strong> <t t-esc="subscription.plan_id.name"/></p>
                                    <p><strong>Duration:</strong> <t t-esc="subscription.plan_id.duration_months"/> month(s)</p>
                                    <hr/>
                                    <h5>Total: <span t-field="subscription.price" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></h5>
                                </div>
                            </div>
                            
                            <div class="mt-3">
                                <a href="/my/subscriptions" class="btn btn-secondary btn-block">Cancel</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>