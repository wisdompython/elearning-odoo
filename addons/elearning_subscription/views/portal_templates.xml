<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Portal Action -->
        <record id="action_portal_subscriptions" model="ir.actions.act_url">
            <field name="name">My Subscriptions</field>
            <field name="url">/my/subscriptions</field>
            <field name="target">self</field>
        </record>

        <!-- Portal Subscriptions List -->
        <template id="portal_subscriptions" name="My Subscriptions">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Subscriptions</t>
                </t>
                
                <div class="o_portal_docs mt-3">
                    <!-- Subscription Plans Section -->
                    <h3 class="mt-4 mb-3">Available Subscription Plans</h3>
                    <div class="row">
                        <t t-foreach="plans" t-as="plan">
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title"><t t-esc="plan.name"/></h5>
                                        <h6 class="card-subtitle mb-2 text-muted">
                                            <span t-field="plan.price" t-options="{'widget': 'monetary', 'display_currency': plan.currency_id}"/>
                                            / <t t-esc="plan.duration_months"/> month(s)
                                        </h6>
                                        <p class="card-text">
                                            <ul>
                                                <li t-if="plan.max_courses > 0">
                                                    Access to <t t-esc="plan.max_courses"/> courses
                                                </li>
                                                <li t-else="">
                                                    Unlimited course access
                                                </li>
                                                <li t-if="plan.max_downloads > 0">
                                                    <t t-esc="plan.max_downloads"/> downloadable resources
                                                </li>
                                                <li t-else="">
                                                    Unlimited downloads
                                                </li>
                                                <li t-if="plan.allow_certification">
                                                    Course certificates included
                                                </li>
                                                <li t-if="plan.allow_forum">
                                                    Forum participation
                                                </li>
                                            </ul>
                                        </p>
                                        <a t-att-href="'/subscription/purchase/%s' % plan.id" class="btn btn-primary">
                                            Subscribe Now
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Voucher Section -->
                    <div class="mt-4 mb-4">
                        <h3 class="mb-3">Have a voucher code?</h3>
                        <form action="/apply-voucher" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="input-group">
                                <input type="text" name="code" class="form-control" placeholder="Enter voucher code" required="required"/>
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-secondary">Apply Code</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Active Subscriptions Section -->
                    <h3 class="mt-4 mb-3">Your Subscriptions</h3>
                    <t t-if="subscriptions">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Plan</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="subscriptions" t-as="subscription">
                                        <td><t t-esc="subscription.name"/></td>
                                        <td><t t-esc="subscription.plan_id.name"/></td>
                                        <td><span t-field="subscription.start_date"/></td>
                                        <td><span t-field="subscription.end_date"/></td>
                                        <td>
                                            <span t-if="subscription.state == 'active'" class="badge badge-success">Active</span>
                                            <span t-elif="subscription.state == 'expired'" class="badge badge-secondary">Expired</span>
                                            <span t-elif="subscription.state == 'pending'" class="badge badge-warning">Pending</span>
                                            <span t-elif="subscription.state == 'cancelled'" class="badge badge-danger">Cancelled</span>
                                            <span t-else="" class="badge badge-info">Draft</span>
                                        </td>
                                        <td>
                                            <a t-att-href="'/my/subscription/%s' % subscription.id" class="btn btn-sm btn-secondary">
                                                View Details
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="alert alert-info">
                            You don't have any subscriptions yet.
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <!-- Subscription Detail Page -->
        <template id="portal_subscription_detail" name="Subscription Detail">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-md-8">
                            <h2>Subscription Details</h2>
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title"><t t-esc="subscription.plan_id.name"/> Plan</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><strong>Reference:</strong> <t t-esc="subscription.name"/></p>
                                            <p><strong>Start Date:</strong> <span t-field="subscription.start_date"/></p>
                                            <p><strong>End Date:</strong> <span t-field="subscription.end_date"/></p>
                                            <p><strong>Status:</strong> 
                                                <span t-if="subscription.state == 'active'" class="badge badge-success">Active</span>
                                                <span t-elif="subscription.state == 'expired'" class="badge badge-secondary">Expired</span>
                                                <span t-elif="subscription.state == 'pending'" class="badge badge-warning">Pending</span>
                                                <span t-elif="subscription.state == 'cancelled'" class="badge badge-danger">Cancelled</span>
                                                <span t-else="" class="badge badge-info">Draft</span>
                                            </p>
                                        </div>
                                        <div class="col-md-6">
                                            <p t-if="subscription.is_voucher_based"><strong>Voucher Code:</strong> <t t-esc="subscription.voucher_code"/></p>
                                            <p><strong>Videos Watched:</strong> <t t-esc="subscription.videos_consumed"/></p>
                                            <p><strong>Downloads Used:</strong> <t t-esc="subscription.downloads_consumed"/></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Courses Accessed -->
                            <h3 class="mt-4">Courses Accessed</h3>
                            <t t-if="subscription.courses_accessed">
                                <div class="list-group">
                                    <t t-foreach="subscription.courses_accessed" t-as="course">
                                        <a t-att-href="'/slides/%s' % course.id" class="list-group-item list-group-item-action">
                                            <t t-esc="course.name"/>
                                        </a>
                                    </t>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-info">
                                    You haven't accessed any courses yet.
                                </div>
                            </t>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Plan Features</h5>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <t t-if="subscription.plan_id.max_courses > 0">
                                            Access to <t t-esc="subscription.plan_id.max_courses"/> courses
                                        </t>
                                        <t t-else="">
                                            Unlimited course access
                                        </t>
                                    </li>
                                    <li class="list-group-item">
                                        <t t-if="subscription.plan_id.max_downloads > 0">
                                            <t t-esc="subscription.plan_id.max_downloads"/> downloadable resources
                                        </t>
                                        <t t-else="">
                                            Unlimited downloads
                                        </t>
                                    </li>
                                    <li class="list-group-item" t-if="subscription.plan_id.allow_certification">
                                        Course certificates included
                                    </li>
                                    <li class="list-group-item" t-if="subscription.plan_id.allow_forum">
                                        Forum participation
                                    </li>
                                </ul>
                            </div>
                            
                            <!-- Renew button (only for active/expired subscriptions) -->
                            <t t-if="subscription.state in ['active', 'expired']">
                                <div class="mt-3">
                                    <a t-att-href="'/subscription/purchase/%s' % subscription.plan_id.id" class="btn btn-primary btn-block">
                                        Renew Subscription
                                    </a>
                                </div>
                            </t>

                            <!-- Cancel button (only for active/pending subscriptions) -->
                            <t t-if="subscription.state in ['active', 'pending']">
                                <div class="mt-3">
                                    <a t-att-href="'/my/subscription/%s/cancel' % subscription.id"
                                       class="btn btn-danger"
                                       onclick="return confirm('Are you sure you want to cancel this subscription?');">
                                        Cancel Subscription
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Voucher Success Page -->
        <template id="voucher_success" name="Voucher Applied Successfully">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="alert alert-success">
                        <h4>Voucher Applied Successfully!</h4>
                        <p>Your <strong><t t-esc="subscription.plan_id.name"/></strong> subscription has been activated.</p>
                        <p>Subscription Reference: <t t-esc="subscription.name"/></p>
                        <p>Valid until: <span t-field="subscription.end_date"/></p>
                    </div>
                    <div class="mt-3">
                        <a href="/my/subscriptions" class="btn btn-primary">View My Subscriptions</a>
                        <a href="/slides" class="btn btn-secondary ml-2">Explore Courses</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- Voucher Error Page -->
        <template id="voucher_error" name="Voucher Error">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="alert alert-danger">
                        <h4>Voucher Error</h4>
                        <p><t t-esc="message"/></p>
                    </div>
                    <div class="mt-3">
                        <a href="/my/subscriptions" class="btn btn-primary">Return to Subscriptions</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- My Subscriptions Template -->
        <template id="portal_my_subscriptions" name="My Subscriptions">
            <t t-call="website.portal_layout">
                <t t-set="page" t-value="'subscription'"/>
                <div class="container mt-3">
                    <div class="row">
                        <div class="col-12">
                            <h1>My Subscriptions</h1>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Plan</th>
                                            <th>Status</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="subscriptions" t-as="subscription">
                                            <tr>
                                                <td><span t-esc="subscription.plan_id.name"/></td>
                                                <td>
                                                    <span t-attf-class="badge badge-#{subscription.state == 'active' and 'success' or subscription.state == 'expired' and 'danger' or 'warning'}">
                                                        <t t-esc="subscription.state"/>
                                                    </span>
                                                </td>
                                                <td><span t-esc="subscription.start_date"/></td>
                                                <td><span t-esc="subscription.end_date"/></td>
                                                <td>
                                                    <span t-esc="subscription.price"/>
                                                    <span t-esc="subscription.currency_id.symbol"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <t t-if="pager">
                                <t t-call="website.pager"/>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Portal Sidebar: Add Subscriptions Link -->
        <!-- <template id="portal_sidebar_inherit_subscriptions" inherit_id="portal.portal_sidebar" name="Portal Sidebar: Add Subscriptions Link">
            <xpath expr="//div[contains(@class, 'o_portal_sidebar_content')]/ul" position="inside">
                <li>
                    <a href="/my/subscriptions">My Subscriptions</a>
                </li>
            </xpath>
        </template> -->
    </data>
</odoo>